# Claude Agent SDK uses the standard Anthropic authentication environment.
ANTHROPIC_API_KEY=

# Optional. Leave blank to use the SDK account default.
OPHIRA_CLAUDE_MODEL=

OPHIRA_DATA_DIR=./data
OPHIRA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OPHIRA_HOST=127.0.0.1
OPHIRA_PORT=8000
OPHIRA_PERMISSION_TIMEOUT_SECONDS=300
OPHIRA_MAX_TURNS=40
OPHIRA_MAX_BUDGET_USD=10
