#!/usr/bin/env bash
# Keeps the shared Caddy's TradeMind site file in step with DNS.
#
# A hostname is added to the site file only once every authoritative nameserver answers
# with this box's address. Until then Caddy never hears of the name, so no certificate
# request fails while the record still points at the old server. Hostnames are only ever
# added; a transient lookup failure never takes a working name away.
set -euo pipefail
. /etc/trademind/ingress.conf   # BOX_IP ALWAYS_HOST APEX WWW UPSTREAM SITE_FILE STATE_FILE

log() { printf '%s\n' "$*"; }

points_here() {
	local host=$1 ns answer seen=0
	for ns in $(dig +short +time=3 +tries=2 NS "$APEX" | head -n 6); do
		answer=$(dig +short +time=3 +tries=1 A "$host" "@$ns" | tail -n 1)
		[ "$answer" = "$BOX_IP" ] || return 1
		seen=$((seen + 1))
	done
	[ "$seen" -ge 1 ]
}

mkdir -p "$(dirname "$STATE_FILE")"
touch "$STATE_FILE"
for host in "$APEX" "$WWW"; do
	if ! grep -qxF "$host" "$STATE_FILE" && points_here "$host"; then
		log "DNS for $host now points at $BOX_IP"
		printf '%s\n' "$host" >> "$STATE_FILE"
	fi
done

apex_ready=0; www_ready=0
grep -qxF "$APEX" "$STATE_FILE" && apex_ready=1
grep -qxF "$WWW" "$STATE_FILE" && www_ready=1

names=$ALWAYS_HOST
[ "$apex_ready" = 1 ] && names="$names, $APEX"
[ "$apex_ready" = 0 ] && [ "$www_ready" = 1 ] && names="$names, $WWW"

new=$(mktemp)
trap 'rm -f "$new"' EXIT
{
	printf '# Generated by trademind-ingress-sync from DNS. Do not edit: see /opt/trademind/deploy/README.md\n'
	printf '%s {\n\treverse_proxy %s\n}\n' "$names" "$UPSTREAM"
	if [ "$apex_ready" = 1 ] && [ "$www_ready" = 1 ]; then
		printf '%s {\n\tredir https://%s{uri} permanent\n}\n' "$WWW" "$APEX"
	fi
} > "$new"

if [ -f "$SITE_FILE" ] && cmp -s "$new" "$SITE_FILE"; then
	changed=0
else
	changed=1
fi

cid=$(docker ps -q -f label=com.docker.compose.project=deploy -f label=com.docker.compose.service=caddy | head -n 1)
if [ -z "$cid" ]; then
	log "shared Caddy container is not running; nothing applied"
	exit 1
fi
if ! docker exec "$cid" test -d /etc/caddy/sites; then
	log "shared Caddy has no /etc/caddy/sites mount yet; nothing applied"
	exit 1
fi

if [ "$changed" = 1 ]; then
	previous=""
	if [ -f "$SITE_FILE" ]; then previous=$(mktemp); cp -p "$SITE_FILE" "$previous"; fi
	install -m 0644 "$new" "$SITE_FILE"
	if ! docker exec "$cid" caddy adapt --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
		if [ -n "$previous" ]; then install -m 0644 "$previous" "$SITE_FILE"; else rm -f "$SITE_FILE"; fi
		[ -n "$previous" ] && rm -f "$previous"
		log "new site file did not parse; kept the previous one"
		exit 1
	fi
	[ -n "$previous" ] && rm -f "$previous"
	docker exec "$cid" caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1
	log "shared Caddy now serves: $names$([ "$apex_ready" = 1 ] && [ "$www_ready" = 1 ] && printf ' (+ %s redirect)' "$WWW")"
fi

if [ "$apex_ready" = 1 ] && [ "$www_ready" = 1 ]; then
	# Nothing left to wait for.
	systemctl disable --now trademind-ingress-sync.timer >/dev/null 2>&1 || true
fi
