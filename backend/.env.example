# Copy to backend/.env for local development (it is git-ignored).
# Endpoints and what has been measured on them: docs/model-providers.md
OPHIRA_MODEL_BASE_URL=https://api.deepseek.com/anthropic
OPHIRA_MODEL=deepseek-v4-pro[1m]
OPHIRA_MODEL_AUTH_TOKEN=
# OPHIRA_MODEL_AUTH_ENV=ANTHROPIC_API_KEY   # for providers that want x-api-key, and Anthropic itself
# OPHIRA_MAX_BUDGET_USD=10                  # cost fuse per turn
# OPHIRA_MODEL_CONTEXT_WINDOW=              # the model's real window, if known
# OPHIRA_DATA_DIR=                          # default: backend/data
