  "decisions": [
    {
      "id": "decision_b9d0b2683c0348fc98776b8c49d955bf",
      "question": "同一 SKU（TRACE-CUP）存在两份差异报价（EN: 2026-09-01 / USD 6.80 / MOQ 500；ZH: 2026-09-03 / USD 7.20 / MOQ 300），且均为合成/未验证材料，如何推进？",
      "outcome": "先澄清报价差异与缺失条件，暂不选择任何报价",
      "decision_type": "plan",
      "rationale": "两份报价在日期（2026-09-01 vs 2026-09-03）、价格（USD 6.80 vs 7.20）、MOQ（500 vs 300）上均不一致，且均为合成/未验证的 fixture 材料；法语转载 repost_fr.md 源自 quote_en.md，不构成独立佐证。运费、认证、有效期等交易条件全部缺失，ZH 是否取代 EN 亦未说明，故无法判定孰优，暂不做选择。",
      "evidence_ids": [
        "ev_6818fdb25c4041e5bbf3e9b2fe41e0da",
        "ev_af8769e65e4a47459130587633e5f689"
      ],
      "hypothesis_ids": [],
      "assumptions": [
        "两份材料均为用户提供的合成 fixture，非真实商业报价",
        "法语 repost_fr.md 是 quote_en.md 的译作/转载，不构成独立来源"
      ],
      "conditions": [
        "需向出具方澄清 ZH 是否取代 EN、真实报价日期与有效期",
        "需补齐运费、认证、币种口径（FOB/EXW 等）与 MOQ 适用条件"
      ],
      "next_actions": [
        "向 Fixture Supplier 确认哪份报价有效及是否存在替代关系",
        "获取真实报价单或原始来源以核验价格与 MOQ",
        "补全运费、认证、有效期等交易条款后再做比较"
      ],
