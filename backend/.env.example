# Claude Agent SDK launches Claude Code. Configure one Anthropic-compatible endpoint.
# Use the credential variable required by that provider; do not paste both unless required.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL is also accepted; OPHIRA_CLAUDE_MODEL is kept for project compatibility.
OPHIRA_CLAUDE_MODEL=

# Optional model mapping. Blank values inherit OPHIRA_CLAUDE_MODEL.
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_FABLE_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
CLAUDE_CODE_EFFORT_LEVEL=
CLAUDE_CODE_AUTO_COMPACT_WINDOW=
CLAUDE_CODE_MAX_CONTEXT_TOKENS=

# Current official Anthropic-compatible presets (copy one set into the values above).
# Pay-as-you-go API endpoints (backend-eligible):
#
# DeepSeek API
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   ANTHROPIC_AUTH_TOKEN=<DeepSeek API Key>
#   OPHIRA_CLAUDE_MODEL=deepseek-v4-pro[1m]
#
# Kimi open platform (pay-as-you-go)
#   ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
#   ANTHROPIC_API_KEY=<Moonshot API Key>
#   OPHIRA_CLAUDE_MODEL=kimi-k3
#
# GLM open platform (pay-as-you-go)
#   ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   ANTHROPIC_AUTH_TOKEN=<GLM API Key>
#   OPHIRA_CLAUDE_MODEL=glm-5.2[1m]
#
# Alibaba Model Studio / Qwen pay-as-you-go (China Beijing)
#   ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
#   ANTHROPIC_AUTH_TOKEN=<Model Studio API Key>
#   OPHIRA_CLAUDE_MODEL=qwen3.7-max
#
# WARNING — coding-subscription plans (Kimi Code membership https://api.kimi.com/coding/,
# GLM Coding Plan, Alibaba Coding Plan https://coding.dashscope.aliyuncs.com/apps/anthropic,
# Token Plan https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic) are licensed for
# personal coding-tool use only. Per PRD v2 §4.9 their ToS prohibit application/backend usage:
# LOCAL DEVELOPMENT DEBUGGING ONLY — never wire them into a deployed OPHIRA backend.

# FR-23 retrieval fallback for providers without native WebSearch/WebFetch.
# Leave provider=none to keep search honestly unconfigured (the ophira_web MCP
# then returns a structured error instead of fabricating results); page fetch
# (fetch_page_snapshot) works without any key.
OPHIRA_SEARCH_PROVIDER=none
OPHIRA_SEARCH_API_KEY=

OPHIRA_DATA_DIR=./data
# Production: https://trademind.store,https://www.trademind.store
OPHIRA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OPHIRA_HOST=127.0.0.1
OPHIRA_PORT=8000
OPHIRA_PERMISSION_TIMEOUT_SECONDS=300
# Gateway-only capability for commercial review/apply (minimum 32 random characters).
# Never expose this value to browsers or Agent workers. Leave blank to disable review/apply.
OPHIRA_COMMERCIAL_APPROVAL_SECRET=
OPHIRA_MAX_TURNS=40
OPHIRA_MAX_BUDGET_USD=10
