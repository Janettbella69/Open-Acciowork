  "decisions": [
    {
      "id": "decision_18e98deaca7a43998bf682176b3d0968",
      "question": "两份合成报价（A：2026-09-01 / USD 6.80 / MOQ 500；B：2026-09-03 / USD 7.20 / MOQ 300）在日期、价格、MOQ 上冲突，且均未说明运费、认证与有效期，如何处置？",
      "outcome": "先澄清报价差异与缺失条件，暂不选择任一报价。",
      "decision_type": "plan",
      "rationale": "两份原始报价（quote_en.md=报价 A、quote_zh.md=报价 B）均标为合成 fixture、未验证，不能作为真实商业报价。两者 SKU 同为 TRACE-CUP、出具方同为 Fixture Supplier，但在报价日期（2026-09-01 vs 2026-09-03）、单价（USD 6.80 vs 7.20）、最低起订量（500 vs 300 件）上不一致；repost_fr.md 为 quote_en.md 的法语翻译/转载，不构成独立报价。报价 B 未说明是否替代报价 A，两份均缺失运费、认证与有效期。因此在缺失条件澄清前不做选择，仅记录差异并保留未知项。",
      "evidence_ids": [
        "ev_b7e70db6b98b48beb6b64965aaa0c25d",
        "ev_9eb155b9adc94d8f91d80d1eb3de5bda"
      ],
