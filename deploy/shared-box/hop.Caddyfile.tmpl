# TradeMind hop: the static frontend, the operator password, and the loopback hand-off to
# the backend. It is rendered into /etc/trademind/hop/Caddyfile on the box (README.md has
# the command); edit this template, not the rendered file.
#
# TLS is terminated by the box's shared Caddy (the memory stack's container), which reaches
# this listener over the Docker bridge. This one runs in the host's network namespace so
# that its requests arrive at the backend from 127.0.0.1.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

(loopback_handoff) {
	# The backend runs in its single-operator mode, which accepts only plain loopback
	# requests and refuses anything that looks proxied. The password has been checked
	# above, so hand the request over as a loopback one and keep the password header
	# out of the application.
	header_up Host __BACKEND__
	header_up -X-Forwarded-For
	header_up -X-Forwarded-Proto
	header_up -X-Forwarded-Host
	header_up -X-Real-IP
	header_up -Forwarded
	header_up -Via
	header_up -Authorization
	flush_interval -1
}

http://:__PORT__ {
	bind __BIND__

	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options SAMEORIGIN
		?Referrer-Policy strict-origin-when-cross-origin
		?Strict-Transport-Security "max-age=31536000"
	}

	request_body {
		max_size 50MB
	}

	@api path /api /api/*
	handle @api {
		basic_auth {
			__USER__ __HASH__
		}
		reverse_proxy __BACKEND__ {
			import loopback_handoff
		}
	}

	handle /health {
		reverse_proxy __BACKEND__ {
			import loopback_handoff
		}
	}

	# Vite content-hashed bundles: cache forever, and a missing file is a real 404.
	@assets path /assets/*
	handle @assets {
		root * __WWW__
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app. Revalidate on every load so a new release
	# is picked up without a hard refresh.
	handle {
		root * __WWW__
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
